---
import type { WorkEntry } from "../data/work";

interface Props {
  entry: WorkEntry;
}
const { entry } = Astro.props;
---

<div class="entry">
  <div>
    <div class="when">{entry.when}</div>
    <div class="status">{entry.status}</div>
  </div>
  <div>
    <h3>{entry.role}</h3>
    <div class="org">{entry.org}</div>
    <p>{entry.body}</p>
    {
      entry.metrics && (
        <div class="metrics">
          {entry.metrics.map((m) => (
            <span>{m}</span>
          ))}
        </div>
      )
    }
  </div>
</div>
