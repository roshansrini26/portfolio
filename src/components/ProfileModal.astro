---
import { site, photos } from "../data/site";

const hasPhotos = photos && photos.length > 0;
---

<div class="overlay" id="profile-overlay" role="dialog" aria-modal="true" aria-label="About Roshan" hidden>
  <div class:list={["panel", { "no-photos": !hasPhotos }]}>
    <button class="panel-close" id="profile-close" aria-label="Close">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
        <path d="M18 6 6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="panel-cards">
      <div class="map-card">
        <span class="map-label">{site.location}</span>
        <iframe
          title="Map of Hamburg"
          loading="lazy"
          src="https://www.openstreetmap.org/export/embed.html?bbox=9.72%2C53.42%2C10.25%2C53.68&layer=mapnik&marker=53.5511%2C9.9937"
        ></iframe>
      </div>

      <a class="link-card" href={site.linkedin || "#"} target="_blank" rel="noopener noreferrer">
        <span class="ic">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.37-1.85c3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.14 2.07 2.07 0 0 1 0 4.14ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z" />
          </svg>
        </span>
        <span class="meta">
          <strong>LinkedIn</strong>
          <em>linkedin.com</em>
        </span>
      </a>

      <a class="link-card" href={site.github} target="_blank" rel="noopener noreferrer">
        <span class="ic">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5A11.5 11.5 0 0 0 .5 12a11.5 11.5 0 0 0 7.86 10.92c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.2 1.77 1.2 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.7 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.8 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.43-2.7 5.4-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 23.5 12 11.5 11.5 0 0 0 12 .5Z" />
          </svg>
        </span>
        <span class="meta">
          <strong>GitHub</strong>
          <em>github.com</em>
        </span>
      </a>

      <a class="link-card" href={`mailto:${site.email}`}>
        <span class="ic">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m2 6 10 7 10-7" />
          </svg>
        </span>
        <span class="meta">
          <strong>Contact</strong>
          <em>to reach out</em>
        </span>
      </a>

      <a class="link-card wide" href={site.cv} target="_blank" rel="noopener noreferrer">
        <span class="ic">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z" />
            <path d="M14 2v6h6" />
            <path d="M8 13h8" />
            <path d="M8 17h5" />
          </svg>
        </span>
        <span class="meta">
          <strong>CV</strong>
          <em>download as PDF</em>
        </span>
      </a>
    </div>

    {
      hasPhotos && (
        <div class="collage">
          {photos.map((src, i) => (
            <img src={src} alt="" loading="lazy" style={`--r:${(i % 2 === 0 ? -1 : 1) * (3 + (i % 3) * 2)}deg`} />
          ))}
        </div>
      )
    }
  </div>
</div>
