---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import WorkEntry from "../components/WorkEntry.astro";
import BuildCard from "../components/BuildCard.astro";

import { site, interests } from "../data/site";
import { work } from "../data/work";
import { builds, skills } from "../data/builds";
---

<Base>
  <section class="hero" id="top">
    <Eyebrow label={site.location} />

    <div class="hero-top">
      <div class="hero-name">
        <h1>{site.name}</h1>
        <p class="role" id="role-line">{site.role}</p>
      </div>

      <div class="hero-avatar">
        <button class="avatar-tile" id="profile-open" aria-label={`More about ${site.name}`}>
          {
            site.avatar ? (
              <img src={site.avatar} alt="" width="98" height="98" />
            ) : (
              site.initials
            )
          }
        </button>
        <span class="avatar-hint" id="profile-hint" aria-hidden="true">Click me</span>
      </div>
    </div>

    <script is:inline>
      // Runs at parse time so the full string never flashes before typing.
      (function () {
        var el = document.getElementById("role-line");
        if (!el) return;

        var reduce =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        var full = el.textContent.trim();

        if (reduce) {
          document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".reveal").forEach(function (n) {
              n.classList.add("in");
            });
          });
          return;
        }

        el.textContent = "";
        var cursor = document.createElement("span");
        cursor.className = "type-cursor";
        cursor.setAttribute("aria-hidden", "true");
        el.appendChild(cursor);

        var i = 0;
        function step() {
          if (i < full.length) {
            cursor.insertAdjacentText("beforebegin", full.charAt(i));
            i++;
            setTimeout(step, 45);
          } else {
            cursor.classList.add("done");
            document.querySelectorAll(".reveal").forEach(function (n, idx) {
              setTimeout(function () {
                n.classList.add("in");
              }, idx * 120);
            });
          }
        }
        setTimeout(step, 400);
      })();
    </script>

    <div class="hero-cols">
      <div class="about reveal">
        <p class="col-label">About</p>
        <p>
          <strong>
            I like problems where the model has to earn its keep outside the
            notebook.
          </strong>{" "}
          That's meant classifying MRIs with a hybrid quantum-classical
          pipeline, streaming live sensor data through Kafka for a real-time
          tracking system, and — most recently — building ML models for a pharma
          research consortium at Fraunhofer.
        </p>
        <p>
          None of those share a domain, but they share the same underlying
          toolkit: get the data honest, get the model interpretable, get the
          whole thing running somewhere other than my laptop.
        </p>
        <p>
          I'm an MSc Data Science candidate at TU Hamburg, hold an AWS Cloud
          Practitioner certification, and spend the rest of my time on
          e-gnition, the university's Formula Student team, where the data is a
          lot faster and a lot louder.
        </p>
      </div>

      <div class="reveal">
        <div class="side-block">
          <p class="col-label">Interests</p>
          <ul class="interest-list">
            {interests.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <Eyebrow label="Work" />
    <h2 class="section-title">Where the models have shipped</h2>
    {work.map((entry) => <WorkEntry entry={entry} />)}
  </section>

  <section id="builds">
    <Eyebrow label="Builds" />
    <h2 class="section-title" style="margin-bottom: 18px;">
      Things built end to end
    </h2>
    <div class="grid">
      {builds.map((build) => <BuildCard build={build} />)}
    </div>
  </section>

  <section id="skills">
    <Eyebrow label="Skills" />
    <h2 class="section-title" style="margin-bottom: 22px;">The toolbox</h2>
    <div class="skillset">
      {
        skills.map((row) => (
          <div class="skillrow">
            <div class="cat">{row.cat}</div>
            <div class="chips">
              {row.items.map((item) => (
                <span class="chip">{item}</span>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <section id="notes">
    <Eyebrow label="Notes" />
    <h2 class="section-title">Writing, occasionally</h2>
    <div class="notes-placeholder">
      <p>
        Longer write-ups on the ML and engineering work above — first few posts
        in progress.
      </p>
      <span>In progress</span>
    </div>
  </section>

  <section id="contact" class="contact">
    <Eyebrow label="Contact" />
    <h2>
      Building something in machine learning, data, or a car that needs faster
      telemetry?
    </h2>
    <p class="lede">
      Based in Hamburg, open to working student roles in data science, ML, and
      analytics.
    </p>
    <div class="contact-links">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">
        github.com/roshansrini26
      </a>
    </div>
  </section>
</Base>
