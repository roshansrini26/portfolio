---
import Base from "../layouts/Base.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Timeline from "../components/Timeline.astro";
import Builds from "../components/Builds.astro";
import Skills from "../components/Skills.astro";
import ContactForm from "../components/ContactForm.astro";
import Research from "../components/Research.astro";

import { site, interests } from "../data/site";
---

<Base>
  <section class="hero" id="top">
    <Eyebrow label={site.location} />

    <div class="hero-top">
      <div class="hero-name">
        <h1>{site.name}</h1>
        <p class="role" id="role-line">{site.role}</p>
        <p class="hero-facts">
          {
            site.facts.map((f, i) => (
              <>
                {i > 0 && (
                  <span class="sep" aria-hidden="true">
                    |
                  </span>
                )}
                <span>{f}</span>
              </>
            ))
          }
        </p>
      </div>

      <div class="hero-avatar">
        <button class="avatar-tile" id="profile-open" aria-label={`More about ${site.name}`}>
          {
            site.avatar ? (
              <img src={site.avatar} alt="" width="98" height="98" />
            ) : (
              site.initials
            )
          }
        </button>
        <span class="avatar-hint" id="profile-hint" aria-hidden="true">
          <svg width="20" height="16" viewBox="0 0 20 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 15C10 9 8 4 5 1.5" />
            <path d="M5 1.5 8.6 3" />
            <path d="M5 1.5 4.2 5.2" />
          </svg>
          Click me
        </span>
      </div>
    </div>

    <script is:inline>
      // Runs at parse time so the full string never flashes before typing.
      (function () {
        var el = document.getElementById("role-line");
        if (!el) return;

        var reduce =
          window.matchMedia &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        var full = el.textContent.trim();

        if (reduce) {
          document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".reveal").forEach(function (n) {
              n.classList.add("in");
            });
          });
          return;
        }

        el.textContent = "";
        var cursor = document.createElement("span");
        cursor.className = "type-cursor";
        cursor.setAttribute("aria-hidden", "true");
        el.appendChild(cursor);

        var i = 0;
        function step() {
          if (i < full.length) {
            cursor.insertAdjacentText("beforebegin", full.charAt(i));
            i++;
            setTimeout(step, 45);
          } else {
            cursor.classList.add("done");
            document.querySelectorAll(".reveal").forEach(function (n, idx) {
              setTimeout(function () {
                n.classList.add("in");
              }, idx * 120);
            });
          }
        }
        setTimeout(step, 400);
      })();
    </script>

    <div class="hero-cols">
      <div class="about reveal">
        <p class="col-label">About</p>
        <p>
          I'm an AI and machine learning engineer, currently completing an MSc
          in Data Science at TU Hamburg. I work across the full chain — from
          raw, inconsistent source data through to a model running somewhere
          other than a notebook.
        </p>
        <p>
          At Fraunhofer ITMP I consolidated measurement data from several
          sources, each with its own protocols, units and detection limits,
          validated and analysed it, then built the machine learning models on
          top.{" "}
          <strong class="underline">
            That order matters: most of what decides whether a model can be
            trusted happens before any training runs.
          </strong>
        </p>
        <p>
          Python and SQL end to end, AWS certified, and hands-on with
          generative AI — including a practical sense of when it isn't the
          right tool. I also turn analysis into reporting people act on, using
          Power BI, Power Query, DAX and Excel data models. My research
          interest sits where computation meets biology, though the day-to-day
          work is ML engineering. I do that work best alongside other people —
          coordinating across teams, making the call when one is needed, and
          getting a group to a single result rather than several.
        </p>
      </div>

      <div class="reveal">
        <div class="side-block">
          <p class="col-label">Interests</p>
          <ul class="interest-list">
            {interests.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="work">
    <Eyebrow label="Work" />
    <Timeline />
  </section>

  <section id="builds">
    <Eyebrow label="Builds" />
    <h2 class="section-title" style="margin-bottom: 18px;">
      Things built end to end
    </h2>
    <Builds />
  </section>

  <section id="skills">
    <Eyebrow label="Skills" />
    <h2 class="section-title" style="margin-bottom: 22px;">The toolbox</h2>
    <Skills />
  </section>

    <section id="research">
    <Eyebrow label="Research" />
    <h2 class="section-title">Research and Publications </h2>
    <Research />
  </section>

  <section id="contact" class="contact">
    <Eyebrow label="Contact" />
    <h2 class="section-title">Say hello</h2>
    <p class="lede">
      Based in Hamburg, open to working student roles in data science, ML, and
      analytics.
    </p>

    <ContactForm />

    <div class="contact-links">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.github} target="_blank" rel="noopener noreferrer">
        github.com/roshansrini26
      </a>
    </div>
  </section>
</Base>
