---
import "../styles/global.css";
import { site, railLinks } from "../data/site";
import ProfileModal from "../components/ProfileModal.astro";

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />

    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") {
            document.documentElement.setAttribute("data-theme", saved);
          } else if (window.matchMedia("(prefers-color-scheme: light)").matches) {
            document.documentElement.setAttribute("data-theme", "light");
          }
        } catch (err) {}
      })();
    </script>

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Caveat:wght@500&display=swap"
    />
  </head>

  <body>
    <aside class="rail" aria-label="Section index">
      <nav>
        {
          railLinks.map((l, i) => (
            <a href={l.href} data-target={l.href} style={`--i:${i}`}>
              <span class="dash" aria-hidden="true" />
              <span class="label">{l.label}</span>
            </a>
          ))
        }
      </nav>

      <button class="theme-btn" id="theme-btn" aria-label="Switch theme" title="Switch theme">
        <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
        </svg>
        <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>

      <div class="rail-foot">
        <span class="loc">
          <span class="dot" aria-hidden="true" />
          <span>{site.shortLocation}</span>
        </span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </aside>

    <ProfileModal />

    <main>
      <div class="wrap">
        <slot />

        <footer>
          <span>© {new Date().getFullYear()} {site.name}</span>
          <span><em>Built with Astro.</em></span>
        </footer>
      </div>
    </main>
    <script is:inline>
      (function () {
        var btn = document.getElementById("theme-btn");
        if (!btn) return;
        btn.addEventListener("click", function () {
          var root = document.documentElement;
          var next =
            root.getAttribute("data-theme") === "light" ? "dark" : "light";
          root.setAttribute("data-theme", next);
          try {
            localStorage.setItem("theme", next);
          } catch (err) {}
        });
      })();
    </script>

    <script is:inline>
      (function () {
        var openBtn = document.getElementById("profile-open");
        var overlay = document.getElementById("profile-overlay");
        var closeBtn = document.getElementById("profile-close");
        if (!openBtn || !overlay) return;

        function open() {
          overlay.hidden = false;
          requestAnimationFrame(function () {
            overlay.classList.add("open");
          });
          if (closeBtn) closeBtn.focus();
        }
        function close() {
          overlay.classList.remove("open");
          openBtn.focus();
          setTimeout(function () {
            overlay.hidden = true;
          }, 320);
        }

        var hint = document.getElementById("profile-hint");
        var SEEN = "profile-panel-seen";

        try {
          if (localStorage.getItem(SEEN)) {
            if (hint) hint.classList.add("gone");
          } else {
            openBtn.classList.add("pulse");
          }
        } catch (err) {
          /* private mode — just show the hint */
        }

        function dismissHint() {
          if (hint) hint.classList.add("gone");
          openBtn.classList.remove("pulse");
          try {
            localStorage.setItem(SEEN, "1");
          } catch (err) {}
        }

        openBtn.addEventListener("click", dismissHint);
        openBtn.addEventListener("click", open);
        if (closeBtn) closeBtn.addEventListener("click", close);
        overlay.addEventListener("click", function (e) {
          if (e.target === overlay) close();
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape" && !overlay.hidden) close();
        });
      })();
    </script>

    <script is:inline define:vars={{ tz: site.timeZone, place: site.location }}>
      (function () {
        var el = document.getElementById("panel-clock");
        if (!el) return;
        function tick() {
          var t = new Date().toLocaleTimeString("en-GB", {
            timeZone: tz,
            hour: "2-digit",
            minute: "2-digit",
          });
          el.textContent = place + " · " + t;
        }
        tick();
        setInterval(tick, 30000);
      })();
    </script>

    <script is:inline>
      (function () {
        var links = Array.prototype.slice.call(
          document.querySelectorAll(".rail a[data-target]")
        );
        if (!links.length || !("IntersectionObserver" in window)) return;

        var map = {};
        links.forEach(function (a) {
          var id = a.getAttribute("data-target").slice(1);
          var el = document.getElementById(id);
          if (el) map[id] = a;
        });

        var visible = {};

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (e) {
              visible[e.target.id] = e.isIntersecting
                ? e.intersectionRatio
                : 0;
            });

            var best = null;
            var bestRatio = 0;
            Object.keys(visible).forEach(function (id) {
              if (visible[id] > bestRatio) {
                bestRatio = visible[id];
                best = id;
              }
            });

            links.forEach(function (a) {
              a.classList.remove("active");
            });
            if (best && map[best]) map[best].classList.add("active");
          },
          { threshold: [0, 0.15, 0.4, 0.75], rootMargin: "-20% 0px -50% 0px" }
        );

        Object.keys(map).forEach(function (id) {
          var el = document.getElementById(id);
          if (el) io.observe(el);
        });
      })();
    </script>
  </body>
</html>
